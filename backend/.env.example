# Database (MongoDB)
# Local example:
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=dealbro

# Ingestion
INGESTION_INTERVAL_MINUTES=30
USER_AGENT=DealBro/1.0 (+https://dealbro.com/bot)

# Rate Limiting (requests per minute per source)
RATE_LIMIT_HOSTINGDISCUSSION=30
RATE_LIMIT_LOWENDTALK=30
RATE_LIMIT_WEBHOSTINGTALK=20

# Logging
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Feature Flags
ENABLE_WEBHOSTINGTALK=false

# LLM API Configuration (for deal extraction and validation)
LLM_API_URL=http://localhost:5005/2121212121/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-5.1
